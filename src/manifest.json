{
  "manifest_version": 3,
  "name": "Hush for Gmail",
  "version": "1.1.0",
  "description": "A quiet, Superhuman-style dark theme and hover shortcuts for Gmail. Layers on top of Simplify Gmail.",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "css": [
        "hush.css"
      ],
      "js": [
        "hush.config.js",
        "hush.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{0bd1b733-b4bb-48ca-932f-9920186a29c3}",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "update_url": "https://raw.githubusercontent.com/omerkaplan/gmail-hush/main/updates.json"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://mail.google.com/*"
  ]
}
